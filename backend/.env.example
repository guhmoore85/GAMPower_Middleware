# =============================================================================
# PAYGO Middleware Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in all values
# All variables are REQUIRED unless marked as optional
# The application will FAIL LOUDLY on startup if required variables are missing
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=development

# Debug mode (enables detailed error responses, more verbose logging)
DEBUG=true

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://paygo:paygo_password@localhost:5432/paygo_db

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis connection string for caching and background tasks
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL=300

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Secret key for JWT and session signing (MUST be at least 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Encryption key for sensitive data (MUST be exactly 32 bytes for AES-256)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32)[:32])"
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# API key for admin endpoints (MUST be at least 32 characters)
ADMIN_API_KEY=your-admin-api-key-here

# JWT token expiration in minutes
JWT_EXPIRATION_MINUTES=60

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# Payment Provider Configuration (Mock values for development)
# -----------------------------------------------------------------------------
# Wave Money API (MOCK - replace with real credentials in production)
WAVE_API_URL=https://api.wave.com/v1
WAVE_API_KEY=mock_wave_api_key
WAVE_WEBHOOK_SECRET=mock_wave_webhook_secret

# QMoney API (MOCK - replace with real credentials in production)
QMONEY_API_URL=https://api.qmoney.com/v1
QMONEY_API_KEY=mock_qmoney_api_key
QMONEY_WEBHOOK_SECRET=mock_qmoney_webhook_secret

# Apple Pay Configuration (MOCK - replace with real certificates in production)
APPLE_PAY_MERCHANT_ID=merchant.com.paygo.mock
APPLE_PAY_CERTIFICATE_PATH=/path/to/certificate.pem
APPLE_PAY_PRIVATE_KEY_PATH=/path/to/private.key

# -----------------------------------------------------------------------------
# OpenPAYGO Configuration
# -----------------------------------------------------------------------------
# Default token validity in days
OPENPAYGO_DEFAULT_TOKEN_DAYS=30

# Maximum token validity in days
OPENPAYGO_MAX_TOKEN_DAYS=365

# Token generation algorithm version
OPENPAYGO_TOKEN_VERSION=2

# -----------------------------------------------------------------------------
# Scheduler Configuration
# -----------------------------------------------------------------------------
# Enable background scheduler for trigger evaluation
SCHEDULER_ENABLED=true

# Trigger evaluation interval in minutes
TRIGGER_EVALUATION_INTERVAL=5

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Log format: json or pretty
LOG_FORMAT=json

# Log file path (optional - omit for stdout only)
LOG_FILE_PATH=./logs/paygo.log

# Log rotation settings
LOG_ROTATION_SIZE=50MB
LOG_RETENTION_COUNT=10

# Enable SQL query logging (development only)
LOG_SQL_QUERIES=true

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Requests per minute for API endpoints
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Requests per minute for webhook endpoints
WEBHOOK_RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# -----------------------------------------------------------------------------
# Health Check Configuration
# -----------------------------------------------------------------------------
# Database health check timeout in seconds
DB_HEALTH_CHECK_TIMEOUT=5

# Redis health check timeout in seconds
REDIS_HEALTH_CHECK_TIMEOUT=5

# -----------------------------------------------------------------------------
# Metrics Configuration (Optional)
# -----------------------------------------------------------------------------
# Enable Prometheus metrics endpoint
METRICS_ENABLED=true
METRICS_PORT=9090
